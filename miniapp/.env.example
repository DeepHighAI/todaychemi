# miniapp/.env.example
# 미니앱(Vite SPA) 환경변수 예시. 실제 값은 .env.local 에 작성.

# ---------------------------------------------------------------------------
# API 서버
# ---------------------------------------------------------------------------
# Next.js 웹앱 백엔드 기본 URL (Vercel 배포 URL 또는 로컬 dev 서버)
VITE_API_BASE_URL=https://todaychemi.vercel.app

# 개발 편의용 Bearer 토큰 (appLogin() 없이 즉시 인증, dev-only)
# VITE_DEV_BEARER=

# ---------------------------------------------------------------------------
# Toss IAP SKU 맵 (4 피처 — 콘솔 상품 등록 후 발급)
# 서버측 TOSS_IAP_SKU_MAP env 와 동일 값이어야 함.
# ---------------------------------------------------------------------------
# 방법 A: JSON 맵으로 한꺼번에 설정 (권장)
VITE_TOSS_IAP_SKU_MAP={"hapcard":"","whatif":"","replay":"","relation_slot":""}

# 방법 B: 피처별 개별 설정 (방법 A 보다 우선순위 높음)
# VITE_TOSS_IAP_SKU_HAPCARD=        # 케미카드 ₩1,000
# VITE_TOSS_IAP_SKU_WHATIF=         # 또 다른 나 ₩800
# VITE_TOSS_IAP_SKU_REPLAY=         # 케미 다시 맞추기 ₩600
# VITE_TOSS_IAP_SKU_RELATION_SLOT=  # 인연 등록 슬롯 ₩1,000

# ---------------------------------------------------------------------------
# 인앱 배너 광고 (콘솔 → 수익화 → 인앱 광고 → 배너 광고 그룹 발급)
# 빌드타임 인라인 값(.ait 에 박힘) — Vercel env 아님. 운영 값은 .env.production 에 둔다.
# 미설정 시: dev 는 테스트 ID 자동 폴백, 운영은 광고 미노출(빈 자리 없음).
# ---------------------------------------------------------------------------
# VITE_TOSS_AD_GROUP_ID=ait.v2.live.xxxxxxxx
