# App public origin (절대 URL, 후행 슬래시 없음). 공유/OG URL + allowed-origin 검사에 사용.
# MVP Production: 커스텀 도메인 없이 고정 Vercel Production *.vercel.app origin을 설정.
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Supabase Google OAuth provider only. Do not commit real values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Local Supabase Kakao OAuth provider + KakaoTalk Share. Do not commit real values.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
KAKAO_ADMIN_KEY=
# C-7 RLS 통합 테스트용 (Supabase Auth 에 미리 생성된 테스트 사용자 2명)
TEST_SUPABASE_USER_A_EMAIL=
TEST_SUPABASE_USER_A_PASSWORD=
TEST_SUPABASE_USER_B_EMAIL=
TEST_SUPABASE_USER_B_PASSWORD=
# Playwright authenticated smoke. Seed with `pnpm seed:test-user`; defaults are documented in docs/specs/auth.md.
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=

# OpenAI (ZDR Enterprise required)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Anthropic (fallback only)
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-5

# KASI 천문연
KASI_SERVICE_KEY=

# Toss Payments Payment Widget (Phase 1)
# Local/preview without merchant keys can use Toss docs widget keys at runtime.
# Production must set live_gck_* and live_gsk_* values.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Temporary legacy aliases accepted by the app while environments are migrated.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# G-8 Google Analytics 4 — 비우면 GA 전체 no-op (속성 설정은 개발 완료 후)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# LLM cost cap
LLM_DAILY_BUDGET_USD=20

# TWA (Phase 0 G5+)
BUBBLEWRAP_KEYSTORE_PATH=
BUBBLEWRAP_KEYSTORE_PASSWORD=

# G2 / Phase 3 — 오늘카드 인연 종합 (today + relation 3축).
# 기본 켜기 (미설정 또는 'true' 시 활성). 문제 발생 시 'false' 로 즉시 단독 today 로 복귀.
# false → /api/today 가 relation-picker 호출 생략 + 단독 daily_hap 프롬프트 사용 + relation 필드 미주입.
NEXT_PUBLIC_TODAY_WITH_RELATION=true

# Apps-in-Toss CORS allowlist (P3 미니앱 크로스오리진 /api/* 허용)
# 쉼표로 구분된 오리진 목록. 콘솔에서 확정된 appName 으로 교체해야 한다.
# 기본값(미설정 시): https://todaychemi.apps.tossmini.com,https://todaychemi.private-apps.tossmini.com
TOSS_ALLOWED_ORIGINS=

# Apps-in-Toss Auth Bridge (P3 Option A)
# TOSS_USER_PASSWORD_SECRET: Supabase 유령 계정 비밀번호 결정형 파생 키.
#   HMAC-SHA256(userKey, secret) → hex 비밀번호. 강한 무작위 문자열 권장(32자+).
#   절대 클라이언트 번들에 포함 금지. Vercel 대시보드 서버 env 에만 등록.
TOSS_USER_PASSWORD_SECRET=
# TOSS_DISCONNECT_BASIC_AUTH: 연결 해제 콜백 Basic Auth 검증값.
#   콘솔에 등록한 "username:password" 문자열 그대로. 예: "todaychemi:s3cret".
#   콘솔 등록값과 반드시 일치해야 한다.
TOSS_DISCONNECT_BASIC_AUTH=

# Apps-in-Toss mTLS 인증서 (§3.3 구현 레퍼런스)
# 콘솔 → 앱 → "mTLS 인증서" 탭 → "+ 발급받기" 에서 PEM 다운로드.
# Vercel 은 개행을 \n 리터럴로 저장하며, 런타임에 자동 복원됨.
# 소비하는 Route Handler 에 export const runtime = 'nodejs'; 선언 필수.
TOSS_MTLS_CERT_PEM=
TOSS_MTLS_KEY_PEM=
# 무중단 cert 회전(§3.2): 신규 cert 콘솔 등록 후 NEXT 에 기입.
# 구 cert 만료 후 NEXT 값을 위 TOSS_MTLS_CERT_PEM/_KEY_PEM 으로 이동.
TOSS_MTLS_CERT_PEM_NEXT=
TOSS_MTLS_KEY_PEM_NEXT=
